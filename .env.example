# ---------------------------------------------------------------------------
# eplug.mn admin console
#
# Deployment layout (see evChargerBack/deploy/nginx-eplug.mn.conf):
#   https://eplug.mn/            this console      (Next.js, port 3001)
#   https://eplug.mn/api/...     CSMS REST API     (Express, port 3000)
#   wss://eplug.mn/ocpp/{id}     charge points
# ---------------------------------------------------------------------------

# Public origin this console is served at.
APP_URL=https://eplug.mn

# Where to reach the CSMS backend. Server-side only: the browser never sees this
# and never calls the backend directly — every request is proxied through this
# Next.js server so the JWT can stay in an httpOnly cookie. Keep it on loopback
# so the API is not exposed twice.
CSMS_API_URL=http://127.0.0.1:3000

# Must match API_BASE_PATH in the backend's .env.
CSMS_API_BASE_PATH=/api

# Optional machine key, used only when there is no user session. Leave empty
# unless you really need it — a value here grants ADMIN.
CSMS_API_KEY=

# Name of the httpOnly session cookie holding the backend JWT.
SESSION_COOKIE_NAME=eplug_session

# Set to false only for local http:// development, so the cookie is still sent.
COOKIE_SECURE=true

# ---------------------------------------------------------------------------
# Public — inlined into the browser bundle. Never put secrets here.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_BRAND_NAME=eplug.mn
NEXT_PUBLIC_BRAND_DOMAIN=eplug.mn
